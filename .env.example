# AI Studio environment variables. Copy to .env.local for local dev.
# NEVER put real keys in this file or in git.

# Server-only (no NEXT_PUBLIC_ prefix). Required for AI logo generation.
GROQ_API_KEY=
# Server-only. Optional: enables true AI upscaling. Without it, the
# enhancer uses the Sharp pipeline and labels results "standard quality".
REPLICATE_API_TOKEN=

# Rate limiting. If both are set, Upstash Redis is used; otherwise an
# in-memory per-IP fallback applies (does not persist across instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile bot protection. If both are set, the widget renders
# and verification is enforced; otherwise tools work without captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public configuration (safe to expose; these are URLs, not secrets).
NEXT_PUBLIC_SITE_URL=https://ai-studio.vercel.app
NEXT_PUBLIC_SISTER_SITE_URL=https://pdf-tools-hub.vercel.app
NEXT_PUBLIC_LEADSFORCEGEN_URL=https://leadsforcegen.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=
# Premium checkout link. Leave unset and no actionable payment button renders.
NEXT_PUBLIC_PREMIUM_CHECKOUT_URL=
# AdSense. Leave unset until approval; the ad slot renders nothing until set.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
