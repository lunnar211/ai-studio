# AI Studio environment variables. Copy to .env.local for local dev.
# NEVER put real keys in this file or in git. PLACEHOLDERS ONLY.

# Server-only (no NEXT_PUBLIC_ prefix). Required for AI logo generation.
GROQ_API_KEY=
# Server-only. Optional: enables true AI upscaling. Without it, the
# enhancer uses the Sharp pipeline and labels results "standard quality".
REPLICATE_API_TOKEN=

# Rate limiting. If both are set, Upstash Redis is used; otherwise an
# in-memory per-IP fallback applies (does not persist across instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile bot protection. If both are set, the widget renders
# and verification is enforced; otherwise tools work without captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Auth + shared database (Supabase Auth, Google-only) ---
# Reuses the owner's EXISTING Supabase project "LeadForge" (Google provider
# already configured there). Do NOT create a new Google Cloud OAuth client
# and do NOT add GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / AUTH_SECRET —
# those belonged to the removed Auth.js setup.
# The project URL is a public identifier (not a secret) and is shown so
# local dev points at the right project; the anon key line below stays an
# EMPTY placeholder in git — never commit a real key value.
NEXT_PUBLIC_SUPABASE_URL=https://omnqidmauvloedscncir.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Postgres pooler string, shared with PDF Tools Hub: paste the
# SAME DATABASE_URL into both sites' Vercel projects. No database =
# guest-only mode (tools keep working; auth/admin show "not configured").
# The schema is pushed ONCE from either repo. The Nov 2026 AI-Studio-only
# LogoGeneration table (saved logo history) is added by pushing from the
# ai-studio repo; pushing the sister repo's schema afterwards does not
# remove it, but do not re-push an older schema expecting new tables.
DATABASE_URL=
# Per-site server-only secret for TOTP cookie signing + TOTP secret
# encryption + IP-hash salt. MUST BE DIFFERENT on each site. Generate:
# openssl rand -base64 32. Rotating it requires TOTP re-enrollment.
# There is deliberately NO SUPABASE_SERVICE_ROLE_KEY in this repo: the
# anon key covers every app path, and Supabase Auth identity deletion is
# done in the Supabase dashboard (see COMPLIANCE_CHECKLIST.md).
TOTP_SECRET=
# Comma-separated admin allowlist. First Google login with an allowlisted
# email becomes ADMIN + SUPER. No passwords, no fallback login, ever.
ADMIN_EMAILS=
# OWNER TAPS before live login works (code cannot do these):
# 1. Supabase dashboard > Authentication > URL Configuration: add redirect
#    https://ai-studio-sandy-sigma.vercel.app/auth/callback (Site URL may
#    stay the project default; the callback route validates `next` itself).
# 2. Vercel (ai-studio project, Production): set NEXT_PUBLIC_SUPABASE_URL,
#    NEXT_PUBLIC_SUPABASE_ANON_KEY, DATABASE_URL, ADMIN_EMAILS, TOTP_SECRET,
#    then redeploy. Never remove/overwrite GROQ_API_KEY.

# --- Paddle Billing (merchant of record, sandbox first) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=
# sandbox | production. Switch to production only after sandbox testing.
PADDLE_ENV=sandbox

# Public configuration (safe to expose; these are URLs, not secrets).
NEXT_PUBLIC_SITE_URL=https://ai-studio-sandy-sigma.vercel.app
NEXT_PUBLIC_SISTER_SITE_URL=https://pdf-tools-hub-nine-lac.vercel.app
NEXT_PUBLIC_LEADSFORCEGEN_URL=https://leadsforcegen.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=
# Legacy premium checkout link. Leave unset; checkout now goes through
# Paddle via /api/checkout (no actionable button renders without Paddle env).
NEXT_PUBLIC_PREMIUM_CHECKOUT_URL=
# AdSense. Leave unset until approval; the ad slot renders nothing until set.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
