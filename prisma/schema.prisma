// AI Studio + PDF Tools Hub SHARED schema (Prisma + PostgreSQL).
// This file MUST stay database-compatible in both sites (same tables
// and columns; indexes and relation names may differ — they do not
// change the database). AI-Studio-only tables, which the sister
// client's queries never touch: LogoGeneration, AiUsageLog, PhotoJob
// (added Nov 2026). Do not rename models, tables, columns, or primary
// keys here.
// Shared database: the owner's existing Supabase Postgres project
// ("LeadForge"); the Supabase pooler DATABASE_URL is pasted into both
// sites' Vercel projects. Auth is Supabase Auth (Google provider), not
// Auth.js: User.supabaseId maps a Supabase Auth user to its Prisma row.
// The Account / Session / VerificationToken tables below are the legacy
// Auth.js adapter tables. They are RETAINED, unused, for shared-database
// parity with the sister site — dropping them would break the shared
// schema push. No code reads or writes them anymore.
// TOTP_SECRET is DIFFERENT per site (never shared).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AdminRole {
  SUPER
  SUPPORT
  FINANCE
}

enum Plan {
  FREE
  PREMIUM
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum JobStatus {
  SUCCESS
  FAILED
}

model User {
  id                  String         @id @default(cuid())
  // Supabase Auth user id (auth.users.id). The ONLY schema change of the
  // Supabase Auth rework: added, nullable + unique so pre-existing rows
  // (none live yet) and email-fallback mapping keep working.
  supabaseId          String?        @unique
  email               String         @unique
  name                String?
  image               String?
  role                Role           @default(USER)
  adminRole           AdminRole?
  plan                Plan           @default(FREE)
  status              UserStatus     @default(ACTIVE)
  country             String?
  dateOfBirth         DateTime?
  ageConfirmed        Boolean        @default(false)
  ageConfirmedAt      DateTime?
  termsAcceptedAt     DateTime?
  totpEnabled         Boolean        @default(false)
  totpSecretEncrypted String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  lastLoginAt         DateTime?
  accounts            Account[]
  sessions            Session[]
  jobs                Job[]
  subscriptions       Subscription[]
  payments            Payment[]
  logoGenerations     LogoGeneration[]
  notes               AdminNote[]    @relation("NoteTarget")
  authoredNotes       AdminNote[]    @relation("NoteAuthor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id           String    @id @default(cuid())
  userId       String?
  tool         String
  status       JobStatus
  inputSummary String?
  errorCode    String?
  costEstimate Float?
  createdAt    DateTime  @default(now())
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// AI-Studio-only additive model (Nov 2026): saved logo generations for the
// account history page. A separate table — NOT columns on Job — so every
// pre-existing Job query keeps working on a database that has not had the
// new schema pushed yet; only the new history code paths degrade (they
// catch the missing-table error and report it honestly). Nullable-safe and
// ignored by the sister site's client. The owner pushes the schema ONCE
// from this repo for history to work; quota counting still uses Job rows.
model LogoGeneration {
  id         String   @id @default(cuid())
  userId     String
  prompt     String
  style      String
  colors     String
  brandName  String?
  variantsJson String
  favorite   Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  provider        String   @default("PADDLE")
  customerId      String
  subscriptionId  String   @unique
  plan            Plan
  status          String
  currentPeriodEnd DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  provider      String   @default("PADDLE")
  transactionId String   @unique
  invoiceId     String?
  amount        Int
  currency      String
  status        String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  ipHash     String?
  createdAt  DateTime @default(now())
}

model AdminNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String
  note      String
  createdAt DateTime @default(now())
  user      User     @relation("NoteTarget", fields: [userId], references: [id], onDelete: Cascade)
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id])
}

model BlockedIp {
  id        String    @id @default(cuid())
  ipHash    String    @unique
  reason    String?
  blockedBy String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model SiteSetting {
  key   String @id
  value String
}

model Expense {
  id        String   @id @default(cuid())
  category  String
  vendor    String
  amount    Int
  currency  String
  date      DateTime
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
}

model SupportMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("OPEN")
  reply     String?
  repliedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String    @unique
  eventType   String
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  path      String?
  createdAt DateTime @default(now())
}

// AI-Studio-only additive model (Nov 2026): per-call AI usage log for
// the provider router (Phase 0). Same pattern as LogoGeneration: a
// separate table, so every pre-existing query keeps working on a
// database that has not had the new schema pushed yet — the usage
// writers catch the missing-table error and the admin health page
// shows an empty state. The owner pushes the schema ONCE from this
// repo for logging + credit accounting to activate; quota counting
// falls back to Job rows until then. Ignored by the sister site.
model AiUsageLog {
  id         String   @id @default(cuid())
  provider   String
  model      String
  capability String
  latencyMs  Int
  success    Boolean
  costUsd    Float    @default(0)
  credits    Int      @default(0)
  userId     String?
  createdAt  DateTime @default(now())

  @@index([provider, createdAt])
  @@index([userId, createdAt])
}

// AI-Studio-only additive model (Nov 2026): async photo jobs for
// colorize / restore / colorize+HD (Phase 1). Vercel functions stop at
// 60s, so long Replicate jobs run as a state machine driven by client
// polling: the poll endpoint advances one step per call (check the
// prediction, LAB-merge, start the upscale, finalize). The job id is a
// random cuid held by the client (URL/localStorage) — that IS the
// resume key. inputData holds the normalized upload ONLY until the
// colorize step finishes, then it is cleared; resultData holds the
// finished image ONLY until the user downloads it (or 2 hours, after
// which polling reports it expired and the row is cleared). Nothing
// here is ever listed or shared. The owner pushes the schema ONCE
// (same push as AiUsageLog/LogoGeneration); until then the colorize
// endpoints return an honest 503 and the capabilities endpoint
// reports colorize as unavailable, so the UI never offers a dead
// button. Ignored by the sister site.
model PhotoJob {
  id             String   @id @default(cuid())
  userId         String?
  mode           String   // "colorize" | "colorize-hd" | "restore"
  status         String   // "QUEUED" | "COLORIZING" | "UPSCALING" | "SUCCEEDED" | "FAILED" | "CANCELED"
  stage          String   // human-readable stage for the progress UI
  style          String   @default("natural")
  era            String   @default("")
  intensity      Int      @default(70)
  outputFormat   String   @default("jpg")
  outputQuality  Int      @default(85)
  scale          Int      @default(2)
  faceEnhance    Boolean  @default(false)
  colorized      Boolean  @default(false) // true once a colorize step ran (restore on colour photos skips it)
  predictionId   String?
  upscalePredId  String?
  inputData      String?  // base64 normalized upload; cleared at terminal state
  preUpscaleData String?  // base64 merged colorized image before the upscale step; lets the Sharp fallback skip re-fetching the colorize output
  inputMime      String   @default("image/jpeg")
  resultData     String?  // base64 finished image; cleared after 2h / on expiry
  resultMime     String?
  resultWidth    Int?
  resultHeight   Int?
  engine         String?  // honest engine note, e.g. "ai-colorize+ai-hd"
  provider       String?
  model          String?
  deliveredAs    String?  // note when the delivered format differs from the request (size cap)
  credits        Int      @default(2)
  costEstimate   Float?   @default(0)
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
