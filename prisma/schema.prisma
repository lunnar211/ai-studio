// AI Studio + PDF Tools Hub SHARED schema (Prisma + PostgreSQL).
// This file MUST stay identical in both sites (except the documented
// supabaseId addition, which the sister site adopts in the same release).
// Do not rename models, tables, columns, or primary keys here.
// Shared database: the owner's existing Supabase Postgres project
// ("LeadForge"); the Supabase pooler DATABASE_URL is pasted into both
// sites' Vercel projects. Auth is Supabase Auth (Google provider), not
// Auth.js: User.supabaseId maps a Supabase Auth user to its Prisma row.
// The Account / Session / VerificationToken tables below are the legacy
// Auth.js adapter tables. They are RETAINED, unused, for shared-database
// parity with the sister site — dropping them would break the shared
// schema push. No code reads or writes them anymore.
// TOTP_SECRET is DIFFERENT per site (never shared).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AdminRole {
  SUPER
  SUPPORT
  FINANCE
}

enum Plan {
  FREE
  PREMIUM
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum JobStatus {
  SUCCESS
  FAILED
}

model User {
  id                  String         @id @default(cuid())
  // Supabase Auth user id (auth.users.id). The ONLY schema change of the
  // Supabase Auth rework: added, nullable + unique so pre-existing rows
  // (none live yet) and email-fallback mapping keep working.
  supabaseId          String?        @unique
  email               String         @unique
  name                String?
  image               String?
  role                Role           @default(USER)
  adminRole           AdminRole?
  plan                Plan           @default(FREE)
  status              UserStatus     @default(ACTIVE)
  country             String?
  dateOfBirth         DateTime?
  ageConfirmed        Boolean        @default(false)
  ageConfirmedAt      DateTime?
  termsAcceptedAt     DateTime?
  totpEnabled         Boolean        @default(false)
  totpSecretEncrypted String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  lastLoginAt         DateTime?
  accounts            Account[]
  sessions            Session[]
  jobs                Job[]
  subscriptions       Subscription[]
  payments            Payment[]
  notes               AdminNote[]    @relation("NoteTarget")
  authoredNotes       AdminNote[]    @relation("NoteAuthor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id           String    @id @default(cuid())
  userId       String?
  tool         String
  status       JobStatus
  inputSummary String?
  errorCode    String?
  costEstimate Float?
  createdAt    DateTime  @default(now())
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  provider        String   @default("PADDLE")
  customerId      String
  subscriptionId  String   @unique
  plan            Plan
  status          String
  currentPeriodEnd DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  provider      String   @default("PADDLE")
  transactionId String   @unique
  invoiceId     String?
  amount        Int
  currency      String
  status        String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  ipHash     String?
  createdAt  DateTime @default(now())
}

model AdminNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String
  note      String
  createdAt DateTime @default(now())
  user      User     @relation("NoteTarget", fields: [userId], references: [id], onDelete: Cascade)
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id])
}

model BlockedIp {
  id        String    @id @default(cuid())
  ipHash    String    @unique
  reason    String?
  blockedBy String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model SiteSetting {
  key   String @id
  value String
}

model Expense {
  id        String   @id @default(cuid())
  category  String
  vendor    String
  amount    Int
  currency  String
  date      DateTime
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
}

model SupportMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("OPEN")
  reply     String?
  repliedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String    @unique
  eventType   String
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  path      String?
  createdAt DateTime @default(now())
}
